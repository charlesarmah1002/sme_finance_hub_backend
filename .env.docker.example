# Copy this file to .env and adjust as needed for local Docker use
DB_HOST=db
DB_PORT=3306
DB_USERNAME=appuser
DB_PASSWORD=apppass
DB_NAME=sme_finance_hub
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_DRIVER=mysql

JWT_SECRET_KEY=local-dev-secret
TOKEN_SIGNATURE=local-token-signature

API_KEY=replace-me
BREVO_API_KEY=replace-me
SMTP_KEY=replace-me
SMTP_PASSWORD=replace-me
SMTP_USERNAME=replace-me
MAIL_FROM=info@example.com
MAIL_FROM_NAME="SME Finance Hub"
MAIL_REPLY_TO=info@example.com
